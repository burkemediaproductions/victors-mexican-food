# Clover credentials belong in Netlify environment variables, never in this file.
CLOVER_MERCHANT_ID=
CLOVER_ACCESS_TOKEN=
CLOVER_PRIVATE_KEY=
CLOVER_ENV=production

CLOVER_ONLINE_ORDERING_ENABLED=true
ONLINE_ORDERING_DAY=Monday,Tuesday,Wednesday,Thursday,Friday,Saturday
ONLINE_ORDERING_TIME=8am,7:30pm
ONLINE_ORDERING_TIMEZONE=America/Los_Angeles
ONLINE_ORDERING_CLOSED_START=2026-08-02
ONLINE_ORDERING_CLOSED_END=2026-08-21
ONLINE_ORDERING_CLOSED_MESSAGE=Online ordering is currently closed. You can still browse the menu and return during our ordering hours.
ONLINE_ORDERING_SPECIAL_CLOSURE_MESSAGE=Victor’s is closed for a family vacation from August 2 through August 21. We reopen Saturday, August 22. Online ordering will return when we reopen.
